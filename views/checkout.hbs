<div class="row justify-content-md-center">
  <script>
    const publishableKey = "{{{publishableKey}}}";
  </script>
  <script type="text/javascript" src="/js/checkout.js" defer></script>
  <div class="col-6">
    <div class="text-center mt-40">
      <h1>
        Checkout — Stripe Press
      </h1>
      <h5 class="text-secondary">
        {{title}}
      </h5>
      <hr class="mt-40">
      <div class="mt-20 text-info">
        Total due: A$<span class="amount" data-amount="{{amount}}"></span>
      </div>
    </div>
    <div class="card box-shadow mt-40">
      <div class="card-body">
        <form id="payment-form">
          <div>
            <label for="email">Email address</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="you@email.com">
          </div>
          <div class="mt-20 text-center text-secondary border-placeholder" id="payment-element">
          </div>
          <div class="mt-20">
            <button id="submit" type="submit" class="btn btn-lg btn-block btn-primary">
              <span id="button-text">Pay $<span class="amount" data-amount="{{amount}}"></span></span>
              <div class="spinner hidden" id="spinner"></div>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
